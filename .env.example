# Copy this file to .env and fill in all values before running docker-compose up.
# NEVER put real secrets in this file — it is committed to git. Real values go in .env (gitignored).

# ── Database ───────────────────────────────────────────────────────────────────
DB_USER=carwashuser
DB_PASSWORD=changeme

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=7200000

# ── Google Gemini (Timah AI chatbot) ──────────────────────────────────────────
GEMINI_API_KEY=

# ── ToyyibPay (FPX payment gateway) ──────────────────────────────────────────
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_RETURN_URL=http://localhost:5173/checkout/return
TOYYIBPAY_CALLBACK_URL=http://localhost:8080/api/v1/payments/toyyibpay/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── SMTP (password-reset emails) ────────────────────────────────────────────────
# Leave MAIL_HOST empty to disable email (app still boots, reset emails skipped).
# Gmail: host=smtp.gmail.com port=587, password = 16-char App Password with spaces
# removed (NOT your account password) from https://myaccount.google.com/apppasswords
# (needs 2FA on). Mailtrap (dev sandbox): host=sandbox.smtp.mailtrap.io port=587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@azurewash.my
