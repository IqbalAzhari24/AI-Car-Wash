# Copy this file to .env and fill in all values before running docker-compose up.

# ── Database ───────────────────────────────────────────────────────────────────
DB_USER=carwashuser
DB_PASSWORD=changeme

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Google Gemini (Timah AI chatbot) ──────────────────────────────────────────
GEMINI_API_KEY=

# ── ToyyibPay (FPX payment gateway) ──────────────────────────────────────────
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_RETURN_URL=http://localhost:5173/checkout/return
TOYYIBPAY_CALLBACK_URL=http://localhost:8080/api/v1/payments/toyyibpay/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
