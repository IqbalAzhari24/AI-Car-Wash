flowchart TD
    classDef initial fill:#111827,stroke:#111827,stroke-width:2px;
    classDef final fill:#111827,stroke:#111827,stroke-width:5px;
    classDef action fill:#eef2ff,stroke:#33415c,stroke-width:1px;
    classDef decision fill:#fff7ed,stroke:#9a3412,stroke-width:1px;
    classDef object fill:#ffffff,stroke:#166534,stroke-width:1.5px;

    subgraph LEGEND["Legend"]
        direction LR
        L1((" ")):::initial
        L2("Action"):::action
        L3{"Decision / Merge"}:::decision
        L4["Object Node"]:::object
        L5((("  "))):::final
        L1 -->|control flow| L2
        L2 -.->|object flow| L4
        L4 --> L3
        L3 --> L5
    end

    subgraph CUST["Customer"]
        I((" ")):::initial
        A2("Type a message\n(WS: /app/timah/chat)"):::action
    end

    subgraph TIMAH["Timah (Gemini 2.5 Flash)"]
        B1("Build system prompt:\ndate, open slots, closures,\nservices, vehicle multipliers"):::action
        B2("Turn 1: generateContent\n(message + tool declarations)"):::action
        B3{"Response type?"}:::decision
        B4("Emit reply\n(streamed token-by-token)"):::action
        B5{"Which tool?"}:::decision
        M1{"Merge"}:::decision
        B6("Turn 2: streamGenerateContent\nwith tool result appended"):::action
        B7("Stream final reply token-by-token\nto /queue/timah-reply"):::action
        B8{"create_booking\nsucceeded?"}:::decision
        B9("Append REDIRECT_CHECKOUT\n{bookingId}"):::action
        Z((("  "))):::final
    end

    subgraph TOOLS["Backend Tools"]
        T1("Query slot_capacities\nfor date range"):::action
        T2("Query slot capacity +\nOpen-Meteo rain forecast"):::action
        T3("Query customer's own\nbookings, newest first"):::action
        T4("BookingService.createBooking:\nreserve required 30-min blocks"):::action
        T5{"Blocks reserved?"}:::decision
        T6("Return error\n(e.g. 409 Conflict)"):::action
        T7("Persist booking,\nstatus = PENDING"):::action
        OBJ["Booking\n«PENDING»"]:::object
    end

    I --> A2
    A2 --> B1 --> B2 --> B3
    B3 -->|Plain text, no tool needed| B4
    B3 -->|functionCall| B5
    B5 -->|get_available_slots| T1
    B5 -->|suggest_wash_time| T2
    B5 -->|get_booking_status| T3
    B5 -->|create_booking| T4
    T4 --> T5
    T5 -->|No| T6
    T5 -->|Yes| T7
    T7 -.->|object flow| OBJ
    T1 --> M1
    T2 --> M1
    T3 --> M1
    T6 --> M1
    T7 --> M1
    M1 --> B6
    B6 --> B7 --> B8
    B4 --> A2
    B8 -->|No| A2
    B8 -->|Yes| B9
    OBJ -.->|object flow| B9
    B9 -->|hands off to Checkout & Payment process| Z
